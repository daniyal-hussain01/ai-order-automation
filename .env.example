# Copy this file to `.env` and fill in values you want to override.
APP_ENV=local
CORS_ORIGINS=*

# Optional: enable Anthropic LLM-assisted parsing
USE_LLM=false
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Optional: live Bravo ERP integration. Leave empty to use built-in mock.
BRAVO_API_URL=
BRAVO_API_KEY=
